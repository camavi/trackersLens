{
  "name": "trackers-lens",
  "version": "0.1.0",
  "private": true,
  "description": "Trackers Lens desktop shell",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/patch-jsswift-assets.cjs && env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "node scripts/patch-jsswift-assets.cjs && env -u ELECTRON_RUN_AS_NODE TL_ELECTRON_DEVTOOLS=1 TL_ENABLE_CUSTOM_NODE_SANDBOX=1 electron .",
    "verify": "node scripts/verify.cjs"
  },
  "devDependencies": {
    "electron": "^44.0.0"
  },
  "dependencies": {
    "jsswift": "^1.0.43"
  }
}
